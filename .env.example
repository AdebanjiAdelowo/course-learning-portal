# Copy to .env.local and fill in. Never commit .env.local.
#
# For local development run `npm run db:start`; it prints the URL and both keys.
# For a hosted project, copy them from Supabase: Project Settings -> API.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon key, or the newer "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of this app, used to build links in password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Slug of the course the public website presents.
NEXT_PUBLIC_COURSE_SLUG=scientific-machine-learning

# Secret: server only. The service-role key, or the newer "secret" key (sb_secret_...).
# Used for seeding, quiz grading and account administration. It bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Password given to the demo accounts created by `npm run seed` (minimum 10 characters).
SEED_DEMO_PASSWORD=
